# NeuroFlow AI Platform Environment Configuration Example
APP_NAME=NeuroFlow AI
ENVIRONMENT=production
DEBUG=false

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Computer Vision & Inference Configuration
MODEL_PATH=yolo11n.pt
TRACKER_TYPE=bytetrack.yaml
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEFAULT_IMGSZ=480

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smarttraffic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smarttraffic

# Cache Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ANPR / OCR Policy Configuration
ANPR_CONFIDENCE_THRESHOLD=55.0
OCR_ENGINE=easyocr
